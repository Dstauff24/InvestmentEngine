# ============================================================================
# Investment Decision Engine — environment template
# ----------------------------------------------------------------------------
# Copy to .env and fill in. .env is gitignored and MUST NEVER be committed.
#   cp .env.example .env && chmod 600 .env
#
# Only secrets, credentials, and host-specific paths belong here. Weights,
# thresholds, and risk numbers live in config/*.yaml (CLAUDE.md, D25).
# ============================================================================

# ── Live network calls (D27) ────────────────────────────────────────────────
# DELIBERATELY NOT SET HERE. Every outbound provider call (FMP, Finnhub,
# Schwab) is refused unless ALLOW_LIVE_CALLS=1 is in the environment at the
# moment of the call:
#
#     ALLOW_LIVE_CALLS=1 python -m jobs.daily_close
#
# Consent is a per-invocation decision, so it belongs on the command line and
# in the cron entries, not in a file that grants it forever. A working API key
# in the environment is NOT consent — that is exactly how quota gets spent by
# accident. Inside pytest the answer is always no and the flag cannot override
# it (core/netguard.py).

# ── Application ─────────────────────────────────────────────────────────────
# Free-form environment name; appears in log lines and alert subject prefixes.
ENGINE_ENV=dev
# Python logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Runtime artifacts the repo must not track (Schwab token, dumps, logs).
# Absolute path on the VM; the default is relative to the repo root.
DATA_DIR=./data

# ── Database (D20: Postgres >=15 + TimescaleDB) ─────────────────────────────
# Either set DATABASE_URL, or set the PG* parts and leave it blank.
# DATABASE_URL wins when both are present.
#
# TWO DATABASES, separated by protection class:
#
#   investment_engine  live collected data. This is what PGDATABASE points at,
#                      in development as well as on the VM. `tests/dbguard.py`
#                      treats the name as PROTECTED and refuses to run the
#                      destructive integration suite against it — a refusal
#                      INTEGRATION_DB_OK=1 cannot override.
#   ie_test            scratch. The integration suite truncates it freely:
#                          PGDATABASE=ie_test pytest -m integration
#
# Keeping both in one database is what let the integration suite wipe a day of
# live collection on 2026-10-20. Create both with `python -m db.init` (it uses
# the PGADMIN_* credentials below to CREATE DATABASE if needed).
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=investment_engine
PGUSER=engine
# Generate with: openssl rand -base64 24
PGPASSWORD=CHANGE_ME
# Separate admin credentials, used ONLY by db/init.py to run CREATE DATABASE.
# The engine role itself does not need this privilege.
PGADMIN_DATABASE=postgres
PGADMIN_USER=postgres
PGADMIN_PASSWORD=CHANGE_ME

# ── Financial Modeling Prep (D4/D29) — fundamentals, calendars ──────────────
# https://site.financialmodelingprep.com/developer/docs -> Dashboard -> API Key
# The account is on the /stable/ API. On the FREE tier these 402 (plan-gated,
# not a path error): sp500-constituent, nasdaq-constituent, analyst-estimates,
# ratios, key-metrics. See CLAUDE.md "Free-tier FMP mode".
FMP_API_KEY=CHANGE_ME
FMP_BASE_URL=https://financialmodelingprep.com
# Requests per minute. This is the rate the shared limiter enforces exactly —
# set it below your plan limit if you want headroom. Transient 429s are retried
# with backoff regardless. The separate DAILY budget is config/universe.yaml's
# fmp.daily_call_budget, not an env var.
#
# PREMIUM allows 750/min; 600 leaves headroom so a burst of retries cannot push
# the engine over the plan limit and turn a transient error into a 429 storm.
# The old free-tier value here was 300, which was WRONG in a way that mattered:
# the free plan's real constraint was ~250 calls/DAY, so a limiter set to 300
# a minute enforced nothing, and on 2026-10-20 the engine issued 247 calls in
# 68 seconds and spent the whole allowance before anyone noticed. A per-minute
# limiter is not a substitute for a daily budget; set both.
FMP_RATE_LIMIT_PER_MIN=600

# ── Finnhub (D5) — company news, FREE tier only ─────────────────────────────
# https://finnhub.io/dashboard  (free tier = 60 calls/min; never plan to pay)
FINNHUB_API_KEY=CHANGE_ME
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_RATE_LIMIT_PER_MIN=60

# ── Schwab Trader API (D3) — prices, option chains, positions ──────────────
# Schwab Developer Portal -> your individual-use app.
SCHWAB_APP_KEY=CHANGE_ME
SCHWAB_APP_SECRET=CHANGE_ME
# Must match the portal registration EXACTLY (scheme, case, trailing slash).
# Port-less on purpose: no local redirect server can bind it, so
# scripts/schwab_auth.py selects schwab-py's manual copy-paste flow, which is
# the settled mechanism (O8) and works headless.
SCHWAB_CALLBACK_URL=https://127.0.0.1
# OAuth token file. Minted on the laptop, synced to the VM weekly (D21/O8).
# Refresh token lives 7 days. Keep it chmod 600; .gitignore blocks it.
SCHWAB_TOKEN_PATH=data/schwab_token.json
# Individual-use limit is 120 req/min; throttle to ~100 (CLAUDE.md).
SCHWAB_RATE_LIMIT_PER_MIN=100

# ── Email digest + failure alerts (D16) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
# For Gmail use an App Password, not the account password.
SMTP_PASSWORD=CHANGE_ME
ALERT_EMAIL_FROM=engine@example.com
ALERT_EMAIL_TO=you@example.com
# Where job failures page. Snapshot jobs must never fail silently (D7).
# Falls back to ALERT_EMAIL_TO when blank.
ALERT_EMAIL_ONFAIL=you@example.com

# ── Shadow / paper account (D44) ────────────────────────────────────────────
# What position sizes resolve against until Schwab balance sync exists — and
# what the SHADOW and PAPER books use for ever, even after it does.
#
# Sizes have to be real numbers for expectancy to mean anything: D11 measures
# R-multiples and R is a function of size. But reading a live balance before
# the engine has placed an order would make the Shadow Book's history depend on
# deposits and withdrawals that have nothing to do with the strategy.
#
# Pick a figure close to what you would actually trade, so the risk percentages
# in config/risk.yaml produce share counts you would recognise.
SHADOW_ACCOUNT_VALUE=100000

# ── Engine VM (D21 / O8) — scripts/sync_token.sh ────────────────────────────
# Where the weekly Schwab token gets synced to. Used ONLY by sync_token.sh,
# which you run from the machine that did the browser auth (a laptop, or a
# Codespace), never on the VM itself.
#
# NOT COMMITTED ON PURPOSE. This is the address of a box holding a live
# brokerage token; a repo is a poor place to publish where that lives. The
# script reads these from .env with a targeted grep (it must not `source` this
# file), and a real environment variable wins over the file either way.
#
#   ENGINE_HOST     user@host. Required; the script refuses without it.
#   ENGINE_PATH     repo path on the VM. Defaults to /home/engine/InvestmentEngine.
#   ENGINE_SSH_KEY  private key to authenticate with. Optional — leave blank to
#                   use your agent or ~/.ssh/config. A leading ~ is expanded.
#
# Check it before you need it, which is the point of the dry run: it opens a
# real connection and verifies the remote repo and data directory exist, then
# sends nothing.
#
#   ./scripts/sync_token.sh --dry-run
ENGINE_HOST=
ENGINE_PATH=/home/engine/InvestmentEngine
ENGINE_SSH_KEY=

# ── Telegram alerts (D16, amended 2026-10-21) ───────────────────────────────
# The channel that reaches a phone. Email is the digest; Telegram is the page.
# Optional: with either value blank, `alerts/notify.py` skips the channel and
# the engine runs on email alone.
#
# Setup: message @BotFather -> /newbot -> copy the token. Then message your new
# bot once (it cannot start a conversation with you) and read the chat id from
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Verify end to end with:
#   ALLOW_LIVE_CALLS=1 python -m scripts.telegram_test
#
# The token is a credential that can send messages as the bot, and it travels
# in the request URL — `alerts/telegram.py` redacts it from every log line and
# error. Never paste it into a chat or a commit.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Backups (D20) — scripts/backup_db.sh ────────────────────────────────────
# Nightly pg_dump, gzipped, uploaded to S3-compatible object storage. More than
# hygiene: the D7 snapshot history cannot be re-fetched from any vendor at any
# price, so the backup is the only copy of the engine's edge.
# Needs: sudo apt install -y awscli postgresql-client-16
BACKUP_DIR=./data/backups
# Blank keeps dumps local only (not a real backup — the script says so). Works
# with AWS S3, Backblaze B2, Hetzner Object Storage, DigitalOcean Spaces.
BACKUP_S3_BUCKET=
# Omit for AWS itself; set for any other provider, e.g.
#   https://fsn1.your-objectstorage.com     (Hetzner)
#   https://s3.us-west-004.backblazeb2.com  (Backblaze)
BACKUP_S3_ENDPOINT=
BACKUP_S3_PREFIX=investment-engine
# Dumps older than this are pruned locally and in the bucket. Pruning only ever
# touches files matching <database>-<timestamp>.dump.gz under the prefix above.
BACKUP_RETENTION_DAYS=30
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ── Phase 2 providers (leave blank until that phase) ────────────────────────
# Claude API — earnings-transcript summarization and tone scoring (D6).
ANTHROPIC_API_KEY=
# FRED — macro series (D6). https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# SEC EDGAR requires a descriptive UA with contact info or it blocks you.
# Quoted: the parentheses would otherwise break a shell that sources this file.
SEC_EDGAR_USER_AGENT="InvestmentEngine/0.1 (you@example.com)"
